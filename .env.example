# Garmin Connect Authentication (headless)
# Base64 (or raw JSON) of ~/.garminconnect/garmin_tokens.json. See "Garmin token" in CLAUDE.md.
GARMIN_TOKENS=base64_encoded_garmin_tokens_json
# Also used as the Gmail sender address for email reports
GARMIN_EMAIL=your_email@gmail.com

# MyFitnessPal (Optional for nutrition tracking)
MFP_EMAIL=your_mfp_email@gmail.com
MFP_PASSWORD=your_mfp_password

# Gmail SMTP (For automated email reports)
GMAIL_APP_PASSWORD=your_16_digit_app_password
